# Required secrets. Generate distinct high-entropy values before any non-test deployment.
MISSION_CONTROL_KEY=replace-with-a-long-random-mission-control-key
ANALYSIS_SERVICE_TOKEN=replace-with-a-separate-long-random-sidecar-token

# Runtime profile and public origin policy.
APP_ENV=production
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Internal service endpoints and bounded verification settings.
ANALYSIS_SERVICE_URL=http://analysis-service:8090
ANALYSIS_SERVICE_CONNECT_TIMEOUT_SECONDS=5
ANALYSIS_SERVICE_READ_TIMEOUT_SECONDS=90
TRUSTED_SOURCE_TIMEOUT_SECONDS=8
TRUSTED_SOURCE_MAX_BYTES=10485760

# Frontend build values. Docker production uses same-origin /api and keeps the mission key server-side.
VITE_API_BASE_URL=/api
VITE_API_KEY=
